<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- CA1416: platform compatibility. The whole product is Windows-only by design. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <Company>SessionForge</Company>
    <Product>SessionForge</Product>
    <Version>0.1.0</Version>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SessionForge.Tests" />
  </ItemGroup>
</Project>
