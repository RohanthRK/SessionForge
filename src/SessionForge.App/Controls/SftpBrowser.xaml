<UserControl x:Class="SessionForge.App.Controls.SftpBrowser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <WrapPanel Margin="4,4,4,2">
            <Button x:Name="UpButton" Style="{DynamicResource Button.Ghost}" ToolTip="Parent folder (Backspace)" Click="Up_Click"><TextBlock Text="&#xE74A;" Style="{DynamicResource Icon}"/></Button>
            <Button Style="{DynamicResource Button.Ghost}" ToolTip="Home folder" Click="Home_Click"><TextBlock Text="&#xE80F;" Style="{DynamicResource Icon}"/></Button>
            <Button Style="{DynamicResource Button.Ghost}" ToolTip="Refresh (F5)" Click="Refresh_Click"><TextBlock Text="&#xE72C;" Style="{DynamicResource Icon}"/></Button>
            <Button Style="{DynamicResource Button.Ghost}" ToolTip="New folder" Click="NewFolder_Click"><TextBlock Text="&#xE8F4;" Style="{DynamicResource Icon}"/></Button>
            <Button Style="{DynamicResource Button.Ghost}" ToolTip="New empty file" Click="NewFile_Click"><TextBlock Text="&#xE8A5;" Style="{DynamicResource Icon}"/></Button>
            <Button Style="{DynamicResource Button.Ghost}" ToolTip="Upload files…" Click="Upload_Click"><TextBlock Text="&#xE898;" Style="{DynamicResource Icon}"/></Button>
            <Button Style="{DynamicResource Button.Ghost}" ToolTip="Upload folder…" Click="UploadFolder_Click"><TextBlock Text="&#xE8DE;" Style="{DynamicResource Icon}"/></Button>
            <Button Style="{DynamicResource Button.Ghost}" ToolTip="Download selected…" Click="Download_Click"><TextBlock Text="&#xE896;" Style="{DynamicResource Icon}"/></Button>
            <ToggleButton x:Name="FollowToggle" ToolTip="Follow terminal folder (requires the shell to report its directory via OSC 7)"><TextBlock Text="&#xE71B;" Style="{DynamicResource Icon}"/></ToggleButton>
            <ToggleButton x:Name="HiddenToggle" ToolTip="Show hidden files" Click="Refresh_Click"><TextBlock Text="&#xE7B3;" Style="{DynamicResource Icon}"/></ToggleButton>
        </WrapPanel>

        <!-- Path bar -->
        <TextBox x:Name="PathBox" Grid.Row="1" Margin="6,2,6,6" FontFamily="{DynamicResource MonoFont}" FontSize="12" KeyDown="PathBox_KeyDown"/>

        <!-- Listing -->
        <Grid Grid.Row="2">
            <ListView x:Name="List" SelectionMode="Extended" MouseDoubleClick="List_DoubleClick" KeyDown="List_KeyDown"
                      PreviewMouseLeftButtonDown="List_PreviewMouseDown" PreviewMouseMove="List_PreviewMouseMove">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Name" Width="210">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Icon}" FontFamily="{DynamicResource IconFont}" FontSize="13" Foreground="{Binding IconBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Size" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SizeText}" HorizontalAlignment="Right" Foreground="{DynamicResource Fg.Secondary}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Modified" Width="130">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ModifiedText}" Foreground="{DynamicResource Fg.Secondary}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Permissions" Width="95">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Entry.Permissions}" FontFamily="{DynamicResource MonoFont}" FontSize="11.5" Foreground="{DynamicResource Fg.Secondary}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Owner" Width="70">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding OwnerText}" Foreground="{DynamicResource Fg.Muted}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open" Click="Open_Click"><MenuItem.Icon><TextBlock Text="&#xE8E5;"/></MenuItem.Icon></MenuItem>
                        <MenuItem Header="Edit (auto-upload on save)" Click="Edit_Click"><MenuItem.Icon><TextBlock Text="&#xE70F;"/></MenuItem.Icon></MenuItem>
                        <MenuItem Header="Download…" Click="Download_Click"><MenuItem.Icon><TextBlock Text="&#xE896;"/></MenuItem.Icon></MenuItem>
                        <Separator/>
                        <MenuItem Header="Rename" InputGestureText="F2" Click="Rename_Click"><MenuItem.Icon><TextBlock Text="&#xE8AC;"/></MenuItem.Icon></MenuItem>
                        <MenuItem Header="Permissions…" Click="Chmod_Click"><MenuItem.Icon><TextBlock Text="&#xE72E;"/></MenuItem.Icon></MenuItem>
                        <MenuItem Header="Copy path" Click="CopyPath_Click"><MenuItem.Icon><TextBlock Text="&#xE8C8;"/></MenuItem.Icon></MenuItem>
                        <Separator/>
                        <MenuItem Header="Delete" InputGestureText="Del" Click="Delete_Click"><MenuItem.Icon><TextBlock Text="&#xE74D;"/></MenuItem.Icon></MenuItem>
                    </ContextMenu>
                </ListView.ContextMenu>
            </ListView>
            <Border x:Name="BusyOverlay" Visibility="Collapsed" Background="{DynamicResource Bg.Overlay}" Opacity="0.6">
                <TextBlock x:Name="BusyText" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
            </Border>
            <Border x:Name="DropHint" Visibility="Collapsed" BorderThickness="2" BorderBrush="{DynamicResource Accent}" Background="{DynamicResource AccentSubtle}" Opacity="0.85" CornerRadius="6" Margin="6">
                <TextBlock Text="Drop to upload here" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
            </Border>
        </Grid>

        <!-- Transfers -->
        <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Border.Default}" x:Name="TransfersPanel" Visibility="Collapsed">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="8,4,4,0">
                    <Button DockPanel.Dock="Right" Style="{DynamicResource Button.Ghost}" Content="Clear" FontSize="11" Click="ClearTransfers_Click"/>
                    <TextBlock Text="TRANSFERS" Style="{DynamicResource Text.Section}" Margin="0,4,0,0"/>
                </DockPanel>
                <ItemsControl x:Name="TransferList" MaxHeight="150" Margin="6,0,6,6">
                    <ItemsControl.Template>
                        <ControlTemplate>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="12"/>
                                    <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Margin="0,3,0,1"/>
                                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource Fg.Muted}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{DynamicResource Button.Ghost}" ToolTip="Cancel" Command="{Binding CancelCommand}" VerticalAlignment="Top" Margin="4,0,0,0">
                                    <TextBlock Text="&#xE711;" FontFamily="{DynamicResource IconFont}" FontSize="10"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
